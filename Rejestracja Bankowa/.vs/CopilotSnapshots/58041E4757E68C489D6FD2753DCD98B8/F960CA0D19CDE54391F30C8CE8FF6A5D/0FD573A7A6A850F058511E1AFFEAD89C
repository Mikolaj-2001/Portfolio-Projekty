			   // Walidacja pól, odblokowuje RegisterBtn tylko gdy wszystkie kryteria spełnione
		private: Void ValidateInputs() {
			// Imię i nazwisko
			bool imieOk = nametxt->Text->Trim()->Length >= 3; // trim usuwa spacje z początku i końca
			bool nazwiskoOk = surnametxt->Text->Trim()->Length >= 5;

			// PESEL: pobierz tylko cyfry i sprawdź długość 11
			String^ peselRaw = personal2txt->Text->Trim();
			String^ peselDigits = Regex::Replace(peselRaw, "\\D", ""); // usuń wszystko, co nie jest cyfrą
			bool peselOk = (peselDigits->Length == 11 && Regex::IsMatch(peselDigits, "^\\d{11}$"));

			// Login: min 4 znaki, tylko litery, cyfry, podkreślenie, kropka, myślnik
			String^ login = logintxt->Text->Trim();
			bool loginOk = (login->Length >= 4 && Regex::IsMatch(login, "^[A-Za-z0-9._-]+$"));

			// Hasło: maska wymusza 12 cyfr (Mask = "000-000-000-000"), policz cyfry
			String^ passRaw = passtxt->Text->Trim();
			String^ passDigits = Regex::Replace(passRaw, "\\D", "");
			bool passOk = (passtxt->MaskCompleted && passDigits->Length == 12);

			// Włącz przycisk rejestracji tylko gdy wszystkie warunki spełnione
			this->RegisterBtn->Enabled = (imieOk && nazwiskoOk && peselOk && loginOk && passOk);
		}


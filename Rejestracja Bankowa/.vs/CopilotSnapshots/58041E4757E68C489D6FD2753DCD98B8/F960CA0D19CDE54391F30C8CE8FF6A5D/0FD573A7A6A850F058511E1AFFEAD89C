		public:Void GenerowanieIdKlienta() {
			array<long long>^ sekwencja = { 5484934,8503250923,5328583,25348 };
			for (int s = 0; s < sekwencja->Length; s++) {
				long long id = sekwencja[s];

				if (id >= 100000000 && id <= 999999999) {
					try {
						OdbcConnection^ connection1 = gcnew OdbcConnection(konfiguracja);
						connection1->Open();
						OdbcCommand^ command1 = connection1->CreateCommand();
						command1->CommandText = "INSERT INTO D_klienta (Nr_id_klienta) VALUES (?)";
						command1->Parameters->Clear();
						command1->Parameters->AddWithValue("p1", id);
						int rows = command1->ExecuteNonQuery();
						connection1->Close();

						if (rows > 0) {
							MessageBox::Show("Twoje ID klienta to: " + id.ToString(), "Komunikat", MessageBoxButtons::OK, MessageBoxIcon::Information);
						}
					}
					catch (Exception^ komunikat) {
						MessageBox::Show(komunikat->Message);
					}
				}
			}
		}
		private: System::Void RegisterBtn_Click(System::Object^ sender, System::EventArgs^ e) {
			if (nametxt->Text->Length < 3 || surnametxt->Text->Length < 5 || personal2txt->Text->Length < 11 || logintxt->Text->Length < 4 || passtxt->Text->Length < 12) {
				MessageBox::Show("Dane nie zostały wpisane", "Błąd", MessageBoxButtons::OK, MessageBoxIcon::Error);
				return;
			}

			// Odblokuj przycisk rejestracji (zachowano oryginalne zachowanie)
			this->RegisterBtn->Enabled = true;

			OdbcConnection^ connection2 = gcnew OdbcConnection(konfiguracja);
			OdbcCommand^ command2 = connection2->CreateCommand();
			OdbcTransaction^ transakcja = nullptr;

			try {
				connection2->Open();
				transakcja = connection2->BeginTransaction(IsolationLevel::ReadCommitted);
				command2->Connection = connection2;
				command2->Transaction = transakcja;

				// 1) Wstaw do D_klienta (parametryzowane)
				// Uwaga: dostosuj nazwy kolumn (`Imie`,`Login_uzyt` itd.) do faktycznej struktury bazy, jeśli różnią się od przykładów.
				command2->CommandText = "INSERT INTO `[D._klienta]` (`Imię`,`Nazwisko`,`PESEL`,`[Login_użyt.]`,`Hasło`) VALUES (?,?,?,?,?)";
				command2->Parameters->Clear();
				command2->Parameters->AddWithValue("p1", nametxt->Text);
				command2->Parameters->AddWithValue("p2", surnametxt->Text);
				command2->Parameters->AddWithValue("p3", personal2txt->Text);
				command2->Parameters->AddWithValue("p4", logintxt->Text);
				command2->Parameters->AddWithValue("p5", passtxt->Text);
				int input1 = command2->ExecuteNonQuery();

				if (input1 <= 0) {
					transakcja->Rollback();
					MessageBox::Show("Dane nie zostały zapisane ([D._klienta])!");
					connection2->Close();
					return;
				}

				command2->CommandText = "INSERT INTO `[Rejes.]` (`Imię`,`Nazwisko`,`PESEL`,`[Login_użyt.]`,`Hasło`) VALUES (?,?,?,?,?)";
				command2->Parameters->Clear();
				command2->Parameters->AddWithValue("q1", nametxt->Text);
				command2->Parameters->AddWithValue("q2", surnametxt->Text);
				command2->Parameters->AddWithValue("q3", personal2txt->Text);
				command2->Parameters->AddWithValue("q4", logintxt->Text);
				command2->Parameters->AddWithValue("q5", passtxt->Text);
				int input2 = command2->ExecuteNonQuery();

				if (input2 <= 0) {
					transakcja->Rollback();
					MessageBox::Show("Dane nie zostały zapisane (Rejes)!");
					connection2->Close();
					return;
				}

				command2->CommandText = "INSERT INTO `[Poś_dn.]` (`Imię`,`[Login_użyt.]`,`Hasło`,`Nazwisko`,`PESEL`) VALUES (?,?,?,?,?,?)";
				command2->Parameters->Clear();
				command2->Parameters->AddWithValue("r1", nametxt->Text);
				command2->Parameters->AddWithValue("r2", logintxt->Text);
				command2->Parameters->AddWithValue("r3", passtxt->Text);
				command2->Parameters->AddWithValue("r4", surnametxt->Text);
				command2->Parameters->AddWithValue("r5", personal2txt->Text);
				int input3 = command2->ExecuteNonQuery();

				if (input3 <= 0) {
					transakcja->Rollback();
					MessageBox::Show("Dane nie zostały zapisane (Pos_dn)!");
					connection2->Close();
					return;
				}

				transakcja->Commit();
				MessageBox::Show("Dane zostały dodane !");

				completing->Visible = true;
				int idxOk = ImList3->Images->IndexOfKey("RegisteringOk.gif");
				if (idxOk >= 0) { completing->Image = ImList3->Images[idxOk]; }
				else {
					try { completing->Image = ImList3->Images[0]; }
					catch (...) {}
				}

				GenerowanieIdKlienta();

				OdbcCommand^ command3 = gcnew OdbcCommand("Select Nr_id_klienta from [D._klienta]", connection2);
				OdbcDataReader^ reader3 = nullptr;
				try {
					if (connection2->State != ConnectionState::Open) connection2->Open();
					reader3 = command3->ExecuteReader();

					if (reader3->Read() && completing->Visible == true) {
						int id_użytkownika = reader3->GetInt32(0);
						this->Hide();
						RejestracjaBankowa::Nawigacja::otwórzRejestracje(this, id_użytkownika);
					}
				}
				catch (Exception^ ex) {
					if (reader3 != nullptr) { try { reader3->Close(); } catch (...) {} }
					if (connection2->State == ConnectionState::Open) { try { connection2->Close(); } catch (...) {} }
					MessageBox::Show("Błąd podczas przekierowania: " + ex->Message);
				}
				finally {
					if (reader3 != nullptr) { try { reader3->Close(); } catch (...) {} }
				}
			}
			catch (Exception^ exOuter) {
				MessageBox::Show("Nieoczekiwany błąd: " + exOuter->Message);
			}
			connection2->Close();
			CzyszczeniePól2();
		}


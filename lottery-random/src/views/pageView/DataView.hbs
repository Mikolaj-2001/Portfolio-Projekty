{{>headers}}

<nav class="navbar bg-body-tertiary" id="navbar">
    <div class="container-fluid justify-content-start" id="sub-navbar">
        <form action="/user/lottery" method="post" style="display: inline;">
            <button class="btn btn-outline-success me-2" type="submit" style="font-style: italic;">Powrót</button>
        </form>
    </div>
</nav>

{{!-- Pamiętaj,aby załatwić sprawę z pokazywaniem się danych w widoku użytkownika --}}
<div class="user-page" id="user-page">
    <div class="user-info" id="user-details" style="
    font-style:italic; background-color: #063ba4; padding: 20px; border-radius: 10px; margin-bottom: 20px;">
        <div class="user-field">
            <div class="field-label">
                <strong>Nazwa Użytkownika:</strong>
            </div>
            <div class="field-value">
                {{user.userName}}
            </div>
        </div>

        <div class="user-field">
            <div class="field-label">
                <strong>Email{poufny}:</strong>
            </div>
            <div class="field-value">
                {{user.encryptedEmail}}
            </div>
        </div>

        <div class="user-field">
            <div class="field-label">
                <strong>ID użytkownika{poufne}:</strong>
            </div>
            <div class="field-value">
                {{user.encryptedId}}
            </div>
        </div>
        {{!-- Lepsza metoda z przekazaniem id w adresie URL --}}
    </div>

    <form action="/user/DataView" method="POST">//Ten formularz jest używany do obsługi przycisku "Odblokuj widok" i
        wywołania funkcji JavaScript, która odblokowuje dostęp do danych użytkownika po wprowadzeniu poprawnego klucza
        weryfikacyjnego.
        <div class="text-center" id="protected-link" style="filter: blur(10px); transition: filter 0.5s ease;">
            <h1 style="font-style: italic;">Link Przekierowujący</h1>
            <code id="connecting-string" onclick="mongoDBCompassDataProtectionFilter()">
                mongodb://localhost:27017/lottery-database?readPreference=primary&directConnection=false&ssl=false
        </code>
            <p class="text-muted">Skopiuj link, aby uzyskać dostęp do danych użytkownika{link ten daje dostęp do bazy
                MongoDB z zaszyfrowaną zawartością.W celu deszyfracji danych kliknij niebieską ikonę na dole i postępuj
                zgodnie z dalszymi instrukcjami.</p>
        </div>
        <button type="button" onclick="unlockProtectedLink()"
            style="font-style: italic;border-radius: 5px; font-weight: bold;margin-bottom: 10px;background-color: #157b03;">Odblokuj
            widok</button>
        <div class="decrypt-section">
            <h2 style="font-style: italic;">Deszyfracja danych{Kod QR}</h2>
            <button type="button" class="btn btn-warning" onclick="decrypteData()"
                style="background-color: rgb(8, 57, 219); font-style: italic;font-weight: bold;">
                <p>Dane są odszyfrowywane czasowo.</p>
                <p>Wymagane jest,aby wpisać klucz weryfikacyjny z ciągu znakowego
                    generowanego z kodu QR.</p>
            </button>
            <div id="qrcode"
                style="width: 320px; height: 320px;margin: left auto;background-color: #f8f9fa;display:none"></div>
            <p><small>Pozostało prób: <span id="attempts-display">3</span>/3</small></p>
            <div id="timing-inference" style="display: none;" class="alert alert-warning">Timer</div>
        </div>
    </form>
    <br>
    <footer>
        <p>&copy; 2025 Loteria osobowości. Autorstwa: Mikołaj Gafiuk.</p>
    </footer>

    {{!-- Biblioteka generująca kod QR --}}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
    {{!-- defer służy do opóźnienia wykonania skryptu do momentu, gdy strona zostanie w pełni załadowana --}}
    <script src="/DataView.js" defer></script>//defer jest ważne, ponieważ skrypt odwołuje się do elementów DOM, które muszą być już załadowane, zanim skrypt zacznie działać.
</div>